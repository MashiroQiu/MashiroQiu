+     * 当 View 附加到窗口时调用。
+     * 用于恢复动画、注册特定监听器等。
+     */
+    fun onAttach()
+
+    /**
+     * 当 View 从窗口移除时调用。
+     * 用于停止动画、清理重型资源。
+     */
+    fun onDetach()
+
+    /**
+     * 当 View 的可见性发生变化时调用。
+     */
+    fun onVisibilityChanged(visible: Boolean)
+}
